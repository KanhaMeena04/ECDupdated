<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>ECDKART Rider</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>ECDKART Rider</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Privacy Permissions -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>ECDKART Rider requires access to your location to assign nearby delivery orders and provide turn-by-turn navigation.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>ECDKART Rider requires background location access to share live delivery status with customers and restaurants while on active delivery routes.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>ECDKART Rider tracks your location during active orders to update customers on order arrival.</string>
		<key>NSCameraUsageDescription</key>
		<string>ECDKART Rider requires camera access to take your profile selfie and capture identity verification documents (driving license, vehicle registration).</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>ECDKART Rider requires photo library access to upload your KYC identification documents and vehicle papers.</string>
		<!-- Background Modes for Live Location Tracking and FCM Alerts -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>fetch</string>
			<string>remote-notification</string>
			<string>audio</string>
		</array>
		<!-- Embedded Views for Google Maps -->
		<key>io.flutter.embedded_views_preview</key>
		<true/>
		<!-- App Transport Security -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>
		<!-- URL Schemes for Navigation & Calls -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>mailto</string>
			<string>https</string>
			<string>http</string>
			<string>comgooglemaps</string>
			<string>waze</string>
		</array>
	</dict>
</plist>
